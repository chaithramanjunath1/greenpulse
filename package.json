{
  "name": "greenpulse",
  "version": "1.0.0",
  "private": true,
  "description": "GreenPulse empowers individuals to understand, track, and reduce their carbon footprint through simple daily actions and personalized insights.",
  "type": "module",
  "main": "server/app.js",
  "scripts": {
    "dev": "concurrently -n srv,web -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/app.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/app.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "prop-types": "^15.8.1",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0",
    "node-cache": "^5.1.2",
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.2",
    "vitest": "^2.1.1",
    "@vitest/coverage-v8": "^2.1.1",
    "jsdom": "^25.0.1",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "globals": "^15.10.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
